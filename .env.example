# ==========================================================================
# Acme Support AI - example environment file
# Copy to `.env` and fill in. NEVER commit the real `.env`.
#   PowerShell : Copy-Item .env.example .env
#   bash       : cp .env.example .env
# Generate SECRET_KEY with: python scripts/generate_secret.py
# ==========================================================================

# ---------- Application ----------
APP_ENV=development
APP_NAME=Acme Support AI
HOST=127.0.0.1
PORT=8000

# ---------- AI provider ----------
# `mock` is the ONLY supported value. It is deterministic, offline and free.
# Any other value makes the application refuse to start.
AI_PROVIDER=mock

# ---------- Database ----------
DATABASE_URL=sqlite:///./storage/app.db
SQL_ECHO=false

# ---------- Security ----------
# REQUIRED in non-development environments. Placeholder only - generate your own.
SECRET_KEY=
# Optional fixed canary token planted in the system prompt. Leave EMPTY to let
# the app generate a random one per process (recommended).
CANARY_TOKEN=

# ---------- Network surface ----------
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
# Comma separated CIDRs/IPs of reverse proxies whose X-Forwarded-For we trust.
# Leave EMPTY when running locally so clients cannot spoof their IP.
TRUSTED_PROXIES=
ENABLE_DOCS_IN_DEV=true
SECURITY_HEADERS_ENABLED=true

# ---------- Sessions / cookies ----------
SESSION_EXPIRE_MINUTES=120
COOKIE_NAME=acme_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CSRF_HEADER_NAME=X-CSRF-Token

# ---------- Passwords ----------
PASSWORD_MIN_LENGTH=10
PASSWORD_MAX_LENGTH=128
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---------- Knowledge base ----------
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=5
MAX_PDF_PAGES=200
MAX_EXTRACTED_CHARS=500000
MAX_DOCUMENTS=200
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=150
PROCESSING_MODE=threadpool

# ---------- Retrieval ----------
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.05
MAX_CONTEXT_CHARS=6000
RETRIEVAL_TIMEOUT_SECONDS=5

# ---------- AI behaviour ----------
MAX_MESSAGE_CHARS=2000
MAX_RESPONSE_CHARS=4000
MAX_HISTORY_MESSAGES=10
MAX_CONVERSATIONS_PER_USER=100
MAX_MESSAGES_PER_CONVERSATION=200
MAX_CONCURRENT_AI=4
AI_TIMEOUT_SECONDS=10

# ---------- Rate limiting ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=15
RATE_LIMIT_CHAT_PER_DAY=300
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=10
RATE_LIMIT_UPLOAD_PER_HOUR=30
RATE_LIMIT_GLOBAL_PER_MINUTE=600
MAX_REQUEST_BODY_BYTES=1048576

# ---------- Privacy / retention ----------
FEEDBACK_COMMENT_MAX_CHARS=1000
RETENTION_DAYS=0

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3
LOG_JSON=true
